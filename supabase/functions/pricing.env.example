# Configure STRIPE_SECRET_KEY only in Supabase Edge Function secrets (never VITE_*).
# Active Stripe Prices must use these lookup keys:
# starttoken_monthly: recurring, month, interval_count=1
# starttoken_annual: recurring, year, interval_count=1
# starttoken_lifetime: one_time
# New plans have no Price ID environment variables.

# Optional technical compatibility for old clients (no pricingVersion / variant A).
STRIPE_PRICE_MONTHLY_LEGACY=price_1Tl5f2GjwjNbQit1yFRXBqBA
STRIPE_PRICE_LIFETIME_LEGACY=price_1Tl5YCGjwjNbQit1821CEBPI
